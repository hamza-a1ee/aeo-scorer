# ─────────────────────────────────────────────────────────────
# AEO App · copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# Google Gen AI SDK (@google/genai). Required: fact sheet, questions,
# judging, fix drafting and the Gemini engine all use it.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite

# Optional engines. Leave a key empty to skip and hide that engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar  

# Supabase (Project Settings → API). The service-role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL, used in share links and the crawler user agent.
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRAWLER_USER_AGENT=AEOAppBot/1.0 (+http://localhost:3000/our-crawler)

# Limits
MAX_PAGES=50
MAX_QUESTIONS=20
SCAN_RATE_LIMIT_PER_DOMAIN_PER_DAY=1
CRAWL_CONCURRENCY=4
ENGINE_CONCURRENCY=2
JUDGE_CONCURRENCY=4
MAX_CONCURRENT_SCANS=2
